{
  "name": "figma-dtcg-design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: export variables & styles as W3C DTCG design tokens and push them to a GitLab repository",
  "scripts": {
    "build": "npm run build:main && npm run build:ui",
    "build:main": "node esbuild.config.mjs",
    "build:ui": "vite build",
    "watch": "npm run build:main -- --watch & vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@preact/preset-vite": "^2.9.0",
    "@types/node": "^22.20.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "preact": "^10.24.0"
  }
}
